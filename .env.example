# Copier en .env et adapter. Toutes les variables sont facultatives.

# Port et adresse d'écoute de l'interface sur la machine hôte (le conteneur écoute toujours sur 80)
WEB_PORT=8080
# 127.0.0.1 = accessible uniquement depuis la machine ; 0.0.0.0 = depuis le réseau
WEB_BIND=127.0.0.1

# Adresse de l'API vue depuis le navigateur (doit suivre API_PORT de calendrier-ffe-api)
API_URL=http://127.0.0.1:8765
